# Copy to .env and fill in. See docs/FAL_API_KEYS.md for key setup.
#
# A .env here is for development. An installed copy reads
# %APPDATA%\SpotOn\.env instead, since its own folder may be read-only.

# Optional: fallback when no key is saved in Settings.
FAL_KEY=

# CORS: comma-separated origins. Default * is fine for local dev.
# CORS_ORIGINS=http://localhost:5173

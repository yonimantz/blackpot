# Copy to .env and fill in. See docs/GEMINI_API_KEYS.md for key setup.

# Optional: shared fallback for local dev when no per-user key is set (see docs).
GEMINI_API_KEY=

# --- Firebase (production / multi-user) ---
# If set, API requires Authorization: Bearer <Firebase ID token> on protected routes.
# FIREBASE_PROJECT_ID=

# Invite list: comma-separated emails (checked before Firestore config).
# ALLOWLIST_EMAILS=you@example.com,friend@example.com

# Skip allowlist check (local dev only — do not use in production).
# AUTH_SKIP_ALLOWLIST=1

# Service account JSON path for Firebase Admin (local). On Cloud Run use default credentials.
# GOOGLE_APPLICATION_CREDENTIALS=

# firebase_storage_bucket optional; defaults to {PROJECT_ID}.appspot.com
# FIREBASE_STORAGE_BUCKET=

# sqlite (default) or firestore
# DATA_BACKEND=sqlite

# CORS: comma-separated origins. Default * (dev). Production: your Hosting URL(s).
# CORS_ORIGINS=https://your-project.web.app,http://localhost:5173

# Copy to .env.local for local dev. Values come from Firebase Console → Project settings → Your apps.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: override API base (default "/api" — Vite proxies to backend in dev).
# For production with Hosting + Cloud Run rewrites, leave unset so requests stay same-origin.
# VITE_API_BASE=/api

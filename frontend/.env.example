# Copy to .env.local for local dev. Values come from Firebase Console → Project settings → Your apps.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: override API base (default "/api" — Vite proxies to backend in dev).
# Same-origin (Firebase Hosting + Cloud Run): leave unset.
# Separate API host (Netlify + Render): full URL, e.g. https://blackpot-api.onrender.com/api
# VITE_API_BASE=/api
